# Strix Wallet trade API — environment
# All optional; sane public defaults are baked in.

# Robinhood Chain RPC (public default works out of the box)
ROBINHOOD_RPC=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_FALLBACK_RPC=

# Ethereum RPC — only used for the ETH/USD reference price (native pricing).
ETH_RPC=https://ethereum-rpc.publicnode.com
